<Window x:Class="RaqmiTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaqmiTweaks.App"
        mc:Ignorable="d"
        Title="Raqmi Tweaks"
        Width="1400"
        Height="840"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#121212">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#1E1E1E" Padding="16">
            <StackPanel>
                <TextBlock Text="Raqmi Tweaks" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24" />
                <TextBlock Text="Dashboard" Margin="0,8" />
                <TextBlock Text="Privacy" Margin="0,8" />
                <TextBlock Text="Network" Margin="0,8" />
                <TextBlock Text="Apps" Margin="0,8" />
                <TextBlock Text="Startup" Margin="0,8" />
                <TextBlock Text="HOSTS" Margin="0,8" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Predicted Boost" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Border Grid.Row="1" Padding="16" Margin="0,0,0,12" CornerRadius="14" Background="#1E1E1E">
                <StackPanel>
                    <TextBlock Text="Estimated impact" Foreground="#B6B8C3" FontSize="12" />
                    <TextBlock Text="{Binding StatusText}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="CPU / RAM / Disk telemetry is sampled on a 500 ms cadence and uses a bounded queue for safe UI rendering." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#D0D4DD" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.8*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Padding="16" CornerRadius="14" Background="#1E1E1E" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CPU Load" Foreground="#B6B8C3" />
                            <TextBlock Text="{Binding Snapshot.CpuDisplay}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" CornerRadius="14" Background="#1E1E1E">
                        <StackPanel>
                            <TextBlock Text="RAM Usage" Foreground="#B6B8C3" />
                            <TextBlock Text="{Binding Snapshot.RamDisplay}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Padding="8" CornerRadius="14" Background="#1E1E1E">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                            <Button Content="Apply selected" Width="120" Margin="0,0,8,0" Command="{Binding ApplySelectedTweaksCommand}" />
                            <Button Content="Revert selected" Width="120" Command="{Binding RevertSelectedTweaksCommand}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding TweakRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#232323"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="On" Width="50" />
                                <DataGridTextColumn Binding="{Binding Title}" Header="Tweak" Width="220" />
                                <DataGridTextColumn Binding="{Binding Category}" Header="Category" Width="140" />
                                <DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*" />
                                <DataGridCheckBoxColumn Binding="{Binding Applied, Mode=OneWay}" Header="Applied" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
